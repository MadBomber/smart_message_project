# projects/smart_message_project
export PROJECT='smart_message'

source_up

export RR=`pwd`     # alias rr='cd $RR'
export WORKING=$RR  # alias r='cd $WORKING

# Bundle mode for the whole workspace — toggled by `asgard dev` / `asgard prod`
# (which write .bundle_mode):
#   dev  → Gemfile.local (local path: deps)
#   prod → Gemfile       (released gems)
# Components inherit this via source_up and must NOT re-export BUNDLE_GEMFILE;
# watch_file makes direnv reload every shell when the mode changes.
watch_file .bundle_mode
if [ "$(cat .bundle_mode 2>/dev/null)" = "prod" ]; then
  export BUNDLE_GEMFILE=Gemfile
else
  export BUNDLE_GEMFILE=Gemfile.local
fi
